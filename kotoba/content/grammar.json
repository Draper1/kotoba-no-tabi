 "items": [
  {
   "id": "g:wa",
   "title": "は — topic marker",
   "unit": 1,
   "form": "Noun + は",
   "note": "Marks what the sentence is about. Written は, pronounced 'wa'.",
   "contrast": "",
   "drills": [
    {
     "jp": "私＿学生です。",
     "answers": [
      "は"
     ],
     "en": "I am a student."
    },
    {
     "jp": "これ＿本です。",
     "answers": [
      "は"
     ],
     "en": "This is a book."
    },
    {
     "jp": "田中さん＿先生ですか。",
     "answers": [
      "は"
     ],
     "en": "Is Mr/Ms Tanaka a teacher?"
    }
   ],
   "seq": 0
  },
  {
   "id": "g:ga_subject",
   "title": "が — subject marker",
   "unit": 2,
   "form": "Noun + が",
   "note": "Marks the subject, especially new information or the answer to 'who/what?'.",
   "contrast": "は introduces what you're talking about; が picks out which one. '誰が来ましたか' asks WHICH person came, so the answer also takes が.",
   "drills": [
    {
     "jp": "誰＿来ましたか。",
     "answers": [
      "が"
     ],
     "en": "Who came?"
    },
    {
     "jp": "猫＿います。",
     "answers": [
      "が"
     ],
     "en": "There is a cat."
    },
    {
     "jp": "私は日本語＿分かります。",
     "answers": [
      "が"
     ],
     "en": "I understand Japanese."
    }
   ],
   "seq": 1
  },
  {
   "id": "g:wo",
   "title": "を — direct object",
   "unit": 3,
